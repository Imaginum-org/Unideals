# ─────────────────────────────────────────────────────────────────────────────
# Unideals backend environment. Copy to `.env` and fill in. Never commit `.env`.
# [required] = app will not work without it · [optional] = has a safe default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# [required] development | production
NODE_ENV=development
# [optional] default 5000
PORT=5000

# ── Origins (CORS + cookie security) ─────────────────────────────────────────
# [required] Marketplace client, e.g. https://app.unideals.in (comma-separate several)
FRONTEND_URL=http://localhost:5173
# [optional] Admin portal origin
ADMIN_FRONTEND_URL=
# [optional] Force Secure cookies outside production (true/false). Auto-on in production or when FRONTEND_URL is https.
COOKIE_SECURE=

# ── Database ─────────────────────────────────────────────────────────────────
# [required] MongoDB connection string
MONGO_URL=
# Optional: Mongo connection pool per instance (keep instances x max under your Atlas tier's limit)
MONGO_MAX_POOL=20
MONGO_MIN_POOL=2
# Optional: set to false on instances that must never run scheduled jobs (jobs are lease-locked anyway)
RUN_JOBS=true

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# [required] Long random strings, different from each other. e.g. `openssl rand -hex 64`
SECRET_KEY_ACCESS_TOKEN=
SECRET_KEY_REFRESH_TOKEN=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# [required for Google sign-in]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. https://api.unideals.in/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Optional. true = ask Google for the account's gender at sign-in (People API,
# scope user.gender.read) so users who share it skip the gender question.
# Enable the People API and get the OAuth consent screen verified for this
# sensitive scope first, or users see an "unverified app" warning.
GOOGLE_GENDER_SCOPE=false
# [optional] Extra client IDs accepted for mobile ID tokens, comma-separated
GOOGLE_MOBILE_CLIENT_IDS=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# [required] Verification and password-reset emails
RESEND_API_KEY=

# ── Media (ImageKit) ─────────────────────────────────────────────────────────
# [required] Uploads and deletes
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# [required for paid plans/boosts] Use Test Mode keys outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signing secret of the webhook pointed at /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── AI assistant ─────────────────────────────────────────────────────────────
# [required for the assistant] Gemini is primary, Groq is the fallback.
GEMINI_API_KEY=
# [optional] default gemini-flash-latest
GEMINI_MODEL=
# [optional] comma-separated, default gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=
# [optional] comma-separated models for the reply writer
GEMINI_COMPOSE_MODELS=
# [optional] default 30000
GEMINI_TIMEOUT_MS=
# [optional] Fallback provider
GROQ_API_KEY=
# [optional] comma-separated, default openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_MODELS=
# [optional] Assistant requests per user per minute, default 30
ASSISTANT_RATE_LIMIT_PER_MINUTE=

# ── System push (Firebase Cloud Messaging) ───────────────────────────────────
# [optional] Push stays off unless PUSH_ENABLED=true AND all three FIREBASE_* are set.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste on one line with literal \n line breaks, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# ── Marketplace tuning (all optional) ────────────────────────────────────────
# Campus shown to guests with no campus, default vit-vellore
DEFAULT_CAMPUS_SLUG=
# ISO date; users who joined before it get the Early Adopter badge
EARLY_ADOPTER_CUTOFF=
# Hot Deals: defaults 48 / 15 / 48 / 8
HOT_QUALIFY_WINDOW_HOURS=
HOT_MIN_UNIQUE_VIEWS=
HOT_DURATION_HOURS=
HOT_MAX_PER_CAMPUS=
# Auth-user cache TTL in ms, default 30000
USER_CACHE_TTL_MS=
