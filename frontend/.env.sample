# ─────────────────────────────────────────────────────────────────────────────
# Unideals frontend environment. Copy to `.env` and fill in. Never commit `.env`.
# Every VITE_* value is baked into the public JS bundle: never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# [required] Backend base URL, e.g. https://api.unideals.in
VITE_API_BASE_URL=http://localhost:5000

# [required for Google sign-in / One Tap]
VITE_GOOGLE_CLIENT_ID=

# [required for checkout] Razorpay public KEY ID only (never the secret)
VITE_RAZORPAY_KEY_ID=

# [required for uploads] ImageKit client config
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=

# [required for the Contact Us form] EmailJS
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# [optional] System push via Firebase Cloud Messaging. Push is off unless
# API key, project ID, app ID and VAPID key are all set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=yourproject.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase console → Project settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=
